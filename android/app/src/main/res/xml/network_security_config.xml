<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Configuración para producción con Always Data (HTTPS) -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">casalai.alwaysdata.net</domain>
    <domain includeSubdomains="true">alwaysdata.net</domain>
  </domain-config>

  <!-- Configuración para desarrollo local (HTTP) -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">192.168.1.1</domain>
    <domain includeSubdomains="true">192.168.0.1</domain>
    <domain includeSubdomains="true">proyecto-casalai-ca</domain>
  </domain-config>

  <!-- Configuración base: permitir HTTPS por defecto -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
